# The name your people open, with HTTPS in front of it: reports.example.com
COMPLYDOC_HOST=

# The folder of reports the viewer serves. Whatever writes reports writes them here.
COMPLYDOC_REPORTS=./reports

# Your identity provider, as an OpenID Connect client registered for
# https://<COMPLYDOC_HOST>/oauth2/callback
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=

# Who may open it, of the people the provider signs in: example.com, or * for all of them.
ALLOWED_EMAIL_DOMAINS=

# 32 random bytes that sign the session cookie:
#   python3 -c "import secrets, base64; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
COOKIE_SECRET=

# The port the proxy listens on, for the load balancer that serves HTTPS.
PROXY_PORT=4180
